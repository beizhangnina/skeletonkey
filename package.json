{
  "name": "@beizhang/skeletonkey",
  "version": "0.3.0",
  "description": "Local-only vault, injecting proxy, trusted runner, and MCP server for your personal API keys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beizhangnina/skeletonkey.git"
  },
  "homepage": "https://skeletonkey.run",
  "bugs": {
    "url": "https://github.com/beizhangnina/skeletonkey/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "skeletonkey": "./dist/cli.js",
    "skk": "./dist/cli.js",
    "skeletonkey-runner": "./dist/runner-bin.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "apis.yaml",
    "data/apis/*.yaml",
    "data/apis/README.md",
    "data/discovered.example.yaml",
    "skills/**/SKILL.md",
    "docs/init-wizard.md",
    "docs/signup.md",
    "docs/v0.1-acceptance.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "skeletonkey": "node --no-warnings dist/cli.js",
    "pretest": "npm run build",
    "prepack": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });' && npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test:pack": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "keywords": [
    "api-keys",
    "skeletonkey",
    "secrets",
    "proxy",
    "mcp",
    "agents",
    "bitwarden",
    "approvals",
    "spend-policy"
  ]
}
